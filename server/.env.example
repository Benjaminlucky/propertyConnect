# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Supabase (PostgreSQL + Auth + Storage) ────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (Never expose the service_role key to the client — server-only)

# ── Cloudinary (listing photo uploads) ───────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Termii (SMS / WhatsApp OTP for NIN/BVN verification) ─────────────────────
# Get from: https://termii.com → API Keys
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=PropConnect

# ── Paystack (premium subscriptions) ─────────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret

# ── Prembly (NIN + BVN identity verification) ────────────────────────────────
# Get from: https://prembly.com → Dashboard → API Keys
# Sign up free; first 100 verifications are free
PREMBLY_API_KEY=your-prembly-api-key
PREMBLY_APP_ID=your-prembly-app-id

# ── Groq (AI listing writer) ─────────────────────────────────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=your-groq-api-key

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000
